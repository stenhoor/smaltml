{
  "name": "@smaltworks/smaltml",
  "version": "0.1.0",
  "description": "Machine learning for smaltdb, on the hardware you have.",
  "keywords": [
    "machine-learning",
    "regression",
    "classification",
    "browser",
    "webgpu",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenhoor/smaltml.git"
  },
  "homepage": "https://stenhoor.github.io/smaltml/",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "node scripts/build.mjs",
    "test:browser": "node test/browser/docs.mjs && node test/browser/hardware.mjs",
    "compare": "python3 compare/run.py",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bench": "npm run build && node bench/smaltml.mjs && node bench/smaltml.mjs --threads 4",
    "bench:python": "OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 python3 bench/reference.py && python3 bench/reference.py",
    "bench:gpu": "node bench/gpu.mjs",
    "bench:report": "node bench/report.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/smaltml.js"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "default": "./dist/core.js"
    },
    "./preprocessing": {
      "types": "./dist/types/preprocessing/index.d.ts",
      "default": "./dist/preprocessing.js"
    },
    "./linear": {
      "types": "./dist/types/linear/index.d.ts",
      "default": "./dist/linear.js"
    },
    "./metrics": {
      "types": "./dist/types/metrics/index.d.ts",
      "default": "./dist/metrics.js"
    },
    "./selection": {
      "types": "./dist/types/selection/index.d.ts",
      "default": "./dist/selection.js"
    },
    "./pipeline": {
      "types": "./dist/types/pipeline/index.d.ts",
      "default": "./dist/pipeline.js"
    },
    "./io": {
      "types": "./dist/types/io/index.d.ts",
      "default": "./dist/io.js"
    },
    "./gpu": {
      "types": "./dist/types/gpu/index.d.ts",
      "default": "./dist/gpu.js"
    },
    "./worker": {
      "types": "./dist/types/worker/index.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker-script": "./dist/smaltml-worker.js",
    "./registry": {
      "types": "./dist/types/registry/index.d.ts",
      "default": "./dist/registry.js"
    },
    "./parallel": {
      "types": "./dist/types/parallel/index.d.ts",
      "default": "./dist/parallel.js"
    },
    "./threads-script": "./dist/smaltml-threads.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "smaltkit": "github:stenhoor/smaltkit#dec0f7e08d1cb3649126b355c921a7f48b88edd9",
    "typescript": "7.0",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  }
}
