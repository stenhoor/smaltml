{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@smaltworks/smaltml": ["./src/index.ts"],
      "@smaltworks/smaltml/*": ["./src/*/index.ts"]
    }
  },
  "include": ["src", "test", "scripts/*.ts", "docs/.vitepress/env.d.ts"]
}
